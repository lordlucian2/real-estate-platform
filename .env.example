# ── Real Estate Agent Platform ───────────────────────────────────────────────
# Copy to .env.local (local dev) or configure in your host (Vercel dashboard).

# Public site URL used for metadata / canonical URLs / sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard password (used only when skipping full auth)
ADMIN_PASSWORD=monrovia2026

# ── PostgreSQL (required in production — Neon) ─────────────────────────────
# Required on Vercel. Create a free Postgres project at neon.tech and paste the
# connection string (with ?sslmode=require). The app stores its runtime data as
# JSON documents in a KeyValue table (see prisma/schema.prisma).
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# ── Cloudinary (property photo uploads) ─────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── WhatsApp ────────────────────────────────────────────────────────────────
# The site-wide business number used for every wa.me deep link.
# Set the same value in src/lib/site.ts (site.whatsappNumber).
# NEXT_PUBLIC_WHATSAPP_NUMBER=231770000000

# ── Email (Resend, for transactional mail) ──────────────────────────────────
# RESEND_API_KEY=